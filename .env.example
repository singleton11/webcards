DATABASE_URL=postgresql://webcards:replace-me@127.0.0.1:5432/webcards
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OWNER_USERNAME=owner
MODEL_BASE_URL=http://127.0.0.1:18317/v1
MODEL_API_KEY=
MODEL_NAME=gpt-6-luna
# Counts translation submissions, not tokens; each can use at most two model calls.
TRANSLATIONS_PER_DAY=100
# Reserves up to two model calls for each non-exact grading request.
GRADINGS_PER_DAY=100
# Optional server-only P-256 private scalar for Web Push, base64url without padding.
WEBCARDS_VAPID_PRIVATE_KEY=
