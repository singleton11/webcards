{$WEBCARDS_ADDRESS:webcards.example.com} {
	root * {$WEBCARDS_STATIC_ROOT:/srv/webcards/dist/frontend}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control no-store
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy {$WEBCARDS_API:127.0.0.1:3001}
	}

	@assets path /assets/*
	handle @assets {
		@existing file
		header @existing Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@public path /icons/* /manifest.webmanifest /robots.txt /reminder-worker.js
	handle @public {
		header /manifest.webmanifest Content-Type application/manifest+json
		file_server
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
