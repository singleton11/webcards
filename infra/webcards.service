[Unit]
Description=Webcards private translation and review API
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Replace /srv/webcards with the absolute path to your checkout before installing.
WorkingDirectory=/srv/webcards
Environment=NODE_ENV=production
Environment=TZ=UTC
Environment=PORT=3001
EnvironmentFile=/srv/webcards/.env.local
ExecStart=/usr/bin/node /srv/webcards/dist/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
