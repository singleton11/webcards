{
  "name": "webcards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:frontend && npm run build:api",
    "start": "node --env-file=.env.local dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "owner:create": "tsx --env-file=.env.local scripts/create-owner.ts",
    "account:create": "tsx --env-file=.env.local scripts/create-account.ts",
    "model:smoke": "tsx --env-file=.env.local scripts/model-smoke.ts",
    "dev:api": "tsx watch --env-file=.env.local src/server.ts",
    "dev:frontend": "vite --host 127.0.0.1",
    "build:frontend": "vite build",
    "build:api": "esbuild src/server.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "better-auth": "1.7.22",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.18.5",
    "ts-fsrs": "5.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8",
    "vitest": "^4.0.0"
  }
}
