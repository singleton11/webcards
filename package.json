{
  "name": "webcards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "owner:create": "tsx --env-file=.env.local scripts/create-owner.ts",
    "account:create": "tsx --env-file=.env.local scripts/create-account.ts",
    "model:smoke": "tsx --env-file=.env.local scripts/model-smoke.ts"
  },
  "dependencies": {
    "better-auth": "1.7.22",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ts-fsrs": "5.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
